# Server
PORT=4000
NODE_ENV=development

# Public URL for Twilio callbacks (set to your deployment URL in prod)
PUBLIC_URL=http://localhost:4000

# Database
DATABASE_URL=postgres://pcphone:pcphone@localhost:5432/pcphone

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=2592000

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY=your_api_key
TWILIO_API_SECRET=your_api_secret

# Push Notifications
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_KEY_PATH=./certs/apns.p8

FCM_SERVICE_ACCOUNT_PATH=./certs/fcm-service-account.json

# S3 (Recordings)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pcphone-recordings

# Push Notifications — APNs (iOS)
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_KEY_PATH=./certs/apns.p8
APNS_BUNDLE_ID=com.pcphone.app

# Push Notifications — FCM (Android)
FCM_SERVER_KEY=your_fcm_server_key

# CORS
CORS_ORIGIN=http://localhost:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
